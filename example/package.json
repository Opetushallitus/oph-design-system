{
  "name": "react-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "update-pkg-version": "cd .. && ./scripts/update-example-pkg-version.sh",
    "deps-and-dev": "npm run update-pkg-version && npm ci --no-audit --prefer-offline --ignore-scripts && npm run dev",
    "test": "npx playwright test",
    "test-docker": "cd .. && ./scripts/run-playwright-tests-in-docker.sh example",
    "start-and-test-docker": "start-server-and-test deps-and-dev 3000 test-docker",
    "start-and-test": "start-server-and-test deps-and-dev 3000 test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/open-sans": "^5.2.7",
    "@mui/icons-material": "^6.4.1",
    "@mui/material": "^6.4.2",
    "@opetushallitus/oph-design-system": "file:../pkg/opetushallitus-oph-design-system-1.2.0.tgz",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5",
    "vite": "^6.4.1"
  }
}
